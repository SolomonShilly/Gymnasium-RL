    },
    {
      "id": "gN9uTnw_uT8pmxkIpsepC",
      "type": "text",
      "x": 572,
      "y": 172.031962138273,
      "width": 642.1595458984375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
