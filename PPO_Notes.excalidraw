      "seed": 620893756,
      "version": 27,
      "versionNonce": 262738492,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786122269389,
      "link": null,
      "locked": false,
      "text": "Deep Deterministic Policy Gradient (DDPG): an algorithm that \nconcurrently learns a Q-function and a policy.  It uses off-policy \ndata and the Bellman equation to learn the Q-function, and uses \nthe Q-function to learn the policy.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Deep Deterministic Policy Gradient (DDPG): an algorithm that \nconcurrently learns a Q-function and a policy.  It uses off-policy \ndata and the Bellman equation to learn the Q-function, and uses \nthe Q-function to learn the policy.",
      "autoResize": true,
      "lineHeight": 1.25
    },
